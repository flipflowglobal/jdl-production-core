# ════════════════════════════════════════════════════
# FLASH LOAN ZERO-GAS ENGINE — ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════
# 1. Copy this file:  mkdir -p ~/jdl && cp .env.template ~/jdl/.env
# 2. Fill PRIVATE_KEY + ALCHEMY_ARB_KEY (the only two required to start)
# 3. NEVER commit ~/jdl/.env to git
#
# Variable names below are EXACTLY what python/flash_loan_engine.py reads.
# (Aliases in parentheses are also accepted.)
# ════════════════════════════════════════════════════

# ── REQUIRED: WALLET ────────────────────────────────────────
# Dedicated executor wallet private key (use a NEW wallet, not your main).
# Needs ZERO ETH — gas is paid by PEG / Gelato relay.
# Generate: python3 -c "from eth_account import Account; print(Account.create().key.hex())"
PRIVATE_KEY=0x

# Wallet address — OPTIONAL. Auto-derived from PRIVATE_KEY if left blank.
WALLET_ADDRESS=

# ── REQUIRED: ARBITRUM RPC ──────────────────────────────────
# Easiest: just paste your Alchemy key here (engine builds the URL).
# Get a free key: alchemy.com → Create App → Arbitrum One → API Key
ALCHEMY_ARB_KEY=

# OR provide a full RPC URL instead of a key (overrides ALCHEMY_ARB_KEY).
# Leave blank to fall back to the public node arb1.arbitrum.io/rpc
# (works for scanning but is rate-limited).
RPC_URL=

# ── FLASHBOTS (needed only for live PEG submission) ──────────────────
# Signing key (no ETH needed). Alias: FLASHBOTS_AUTH_KEY
# Generate: python3 -c "from eth_account import Account; print(Account.create().key.hex())"
FLASHBOTS_SECRET=0x

# ── DEPLOYED CONTRACT (OPTIONAL — scan mode works without it) ─────────
# Set after deploying FlashZeroGas.sol to go live. Alias: CONTRACT_ADDRESS
FLASH_CONTRACT_ADDRESS=
# ProfitPaymaster.sol (optional EIP-4337 paymaster)
PAYMASTER_ADDRESS=

# ── OPTIONAL RELAYS ──────────────────────────────────────
# Gelato free relay (sponsors gas on first runs). app.gelato.network → API Keys
GELATO_API_KEY=
# Biconomy gasless (secondary). dashboard.biconomy.io
BICONOMY_API_KEY=

# ── NETWORK / TUNING ────────────────────────────────────
CHAIN_ID=42161
# Minimum net profit (USD) before the engine submits a trade
MIN_PROFIT_USD=0.50

