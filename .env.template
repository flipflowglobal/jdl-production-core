# Flash Zero Gas — Environment Variables Template
# Copy to ~/jdl/.env and fill in all values.

# ── Required ──────────────────────────────────────────────────────────────────────────
WALLET_ADDRESS=0xYourWalletAddressHere
PRIVATE_KEY=your_private_key_64_hex_chars_no_0x_prefix

# Alchemy RPC (get free key at alchemy.com)
ALCHEMY_ARB_KEY=your_alchemy_arbitrum_api_key
ALCHEMY_ETH_KEY=your_alchemy_ethereum_api_key

# Flashbots (create at flashbots.net — can be any private key, not your wallet key)
FLASHBOTS_SECRET=your_flashbots_signing_private_key

# Deployed contract addresses (after running Forge/Hardhat deploy)
FLASH_CONTRACT_ADDRESS=0xDeployedFlashZeroGasContractAddress
PAYMASTER_ADDRESS=0xDeployedProfitPaymasterContractAddress

# ── Optional (enables additional gas strategies) ────────────────────────────────
# Gelato relay (free tier at relay.gelato.digital)
GELATO_API_KEY=optional_gelato_api_key

# Biconomy meta-tx relay (biconomy.io)
BICONOMY_API_KEY=optional_biconomy_api_key
