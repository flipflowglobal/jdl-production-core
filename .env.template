# Flash Loan Engine — Environment Variables
# Copy to ~/jdl/.env and fill in all values.

# ── Required ──────────────────────────────────────────────────────────────
WALLET_ADDRESS=0xYourWalletAddressHere
PRIVATE_KEY=your_64_hex_chars_private_key_no_0x_prefix
ALCHEMY_ARB_KEY=your_alchemy_arbitrum_api_key
ALCHEMY_ETH_KEY=your_alchemy_ethereum_api_key

# Flashbots signing key (any private key — NOT your wallet key)
FLASHBOTS_SECRET=your_flashbots_signing_private_key

# Deployed contract addresses (after forge deploy)
FLASH_CONTRACT_ADDRESS=0xDeployedFlashZeroGasAddress
PAYMASTER_ADDRESS=0xDeployedProfitPaymasterAddress

# ── Optional (enables extra gas strategies) ───────────────────────────────
GELATO_API_KEY=optional_gelato_relay_key
BICONOMY_API_KEY=optional_biconomy_meta_tx_key
