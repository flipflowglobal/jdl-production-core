# ══════════════════════════════════════════════════════════
# FLASH LOAN ZERO-GAS ENGINE — ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════
# 1. Copy this file: cp .env.template ~/jdl/.env
# 2. Fill in every value below
# 3. NEVER commit ~/jdl/.env to git
# See README_FLASH.md for full instructions on each variable
# ════════════════════════════════════════════════════

# ── WALLET ─────────────────────────────────────────────────
# Dedicated executor wallet private key (NEW wallet recommended)
# Generate with: cast wallet new
# Format: 0x followed by 64 hex characters
PRIVATE_KEY=<set-via-secrets-manager>

# ── RPC ENDPOINTS ──────────────────────────────────────────
# Arbitrum One HTTPS RPC
# Get free key at: alchemy.com → Create App → Arbitrum One
RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE

# ── FLASHBOTS ─────────────────────────────────────────────
# Flashbots auth private key (no ETH needed, just for signing)
# Generate with: cast wallet new
FLASHBOTS_AUTH_KEY=0x
# Flashbots relay (use Protect RPC for Arbitrum)
FLASHBOTS_RELAY_URL=https://rpc.flashbots.net/fast

# ── DEPLOYED CONTRACT ADDRESSES ────────────────────────────
# Fill in after running: forge create FlashZeroGas ...
FLASH_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Fill in after running: forge create ProfitPaymaster ...
PAYMASTER_ADDRESS=0x0000000000000000000000000000000000000000

# ── PROTOCOL ADDRESSES (Arbitrum One — DO NOT CHANGE) ──────
# Aave V3 Pool
AAVE_POOL_ADDRESS=0x794a61358D6845594F94dc1DB02A252b5b4814aD
# Balancer V2 Vault (0% flash loan fee)
BALANCER_VAULT_ADDRESS=0xBA12222222228d8Ba445958a75a0704d566BF2C8
# Wrapped ETH on Arbitrum
WETH_ADDRESS=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
# Native USDC on Arbitrum (not bridged USDC.e)
USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
# Uniswap V3 Factory (same on all chains)
UNISWAP_V3_FACTORY=0x1F98431c8aD98523631AE4a59f267346ea31F984
# Morpho Blue (0% flash loan fee)
MORPHO_BLUE_ADDRESS=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb

# ── GELATO BOOTSTRAP (optional but recommended for first run)
# Get free API key at: app.gelato.network → API Keys
GELATO_RELAY_URL=https://relay.gelato.digital/relays/v2/call-with-sync-fee
GELATO_API_KEY=

# ── GASLESS MODE (Gelato Relay ERC-2771 — wallet never needs ETH) ──
# When GELATO_ENABLED=1, every arbitrage is submitted through Gelato Relay:
# Gelato pays the Arbitrum gas and is reimbursed from the trade's profit (in the
# loan asset), so the executor wallet holds ZERO ETH. The on-chain relay fee is
# bounded by an owner-signed maxFee, so it can never exceed the trade's profit.
GELATO_ENABLED=0
# Sponsor key for the ONE-TIME gasless deploy (deploy_gelato.py). Create at
# app.gelato.network and fund 1Balance with ~$1 USDC. Not needed once deployed.
GELATO_SPONSOR_API_KEY=
# Optional: token Gelato charges its fee in (defaults to the loan asset, e.g. USDC).
# GELATO_FEE_TOKEN=
# Optional hard cap on the Gelato fee per trade in USDC 6-dp (0 = derive per-trade).
# GELATO_MAX_FEE_USD6=0

# ── BICONOMY (optional — secondary gas strategy) ────────────
# Get at: dashboard.biconomy.io → Gasless
BICONOMY_API_KEY=
# Optional bundler endpoint override (defaults to the public Stackup Arbitrum node).
# Do NOT commit a URL with an embedded API key.
# BICONOMY_BUNDLER_URL=https://api.stackup.sh/v1/node/arb

# ── NETWORK ────────────────────────────────────────────────
# Arbitrum One chain ID
CHAIN_ID=42161
# Flashbots MEV-Share SSE stream (public, no key needed)
MEV_SHARE_URL=https://mev-share.flashbots.net

# ── SWARM (maximum parallel scanning) ───────────────────────
# Number of concurrent scan workers. Each sweeps a DISJOINT slice of the route
# universe, so N workers scan N× the market per tick with zero overlap.
#   auto = CPU cores (recommended) | max = 4×cores capped 32 | or an explicit int
# Scanning parallelism is bounded by CPU + RPC rate limits (the engine fails over
# across its RPC pool). NOTE: execution from a single wallet is serialized on-chain
# by nonce order — for genuinely parallel execution, run multiple wallets.
SWARM_WORKERS=auto

# ── ENGINE PARAMETERS ───────────────────────────────────────
# Minimum net profit per execution (USDC 6-decimal units)
# 500000 = $0.50 | 1000000 = $1.00 | 5000000 = $5.00
MIN_PROFIT_USD6=500000

# Builder tip as basis points of gross profit
# 100 bps = 1% | 500 = 5% | 800 = 8%
# Higher = better Flashbots inclusion probability
BUILDER_FEE_BPS=500

# Gas reserve allocation as basis points of gross profit
# 1000 = 10% reserved in contract for self-funding PEG
GAS_RESERVE_BPS=1000

# Withdrawal lock threshold in USDC (6 decimals)
# 1000000000 = $1,000.00 | 500000000 = $500.00
WITHDRAW_THRESHOLD_USD6=1000000000

# Max slippage for AMM trades (basis points)
# 50 = 0.5% | 100 = 1%
MAX_SLIPPAGE_BPS=50

# Maximum flash loan amount per execution (USDC 6-decimal)
# 1000000000000 = $1,000,000 cap per loan
MAX_LOAN_USD6=1000000000000

# ── LOGGING ────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── DATA DIRECTORY ───────────────────────────────────────────
# Where SQLite database and logs are stored
# Default: ~/.flash_loan_engine/
DATA_DIR=

# ══════════════════════════════════════════════════════════
# FLASH ENGINE ALIASES (read by python/flash_loan_engine.py)
# The engine accepts these in ADDITION to the variables above,
# so any existing .env keeps working. Set whichever you prefer.
# ══════════════════════════════════════════════════════════
# Alchemy Arbitrum key — optional alternative to RPC_URL above.
# If set, the engine builds the RPC URL automatically.
ALCHEMY_ARB_KEY=
# Flashbots signing key — alias of FLASHBOTS_AUTH_KEY above.
FLASHBOTS_SECRET=
# Minimum net profit in plain USD — alias of MIN_PROFIT_USD6.
MIN_PROFIT_USD=0.50
# Live execution switch. OFF (blank/0) = engine builds real calldata but never
# broadcasts (paper/dry-run). 1/true/yes/on = broadcast initiateFlashLoan txs.
# Flash loans are atomic — an unprofitable route reverts on-chain (only gas lost).
LIVE_EXECUTION=
