API_KEY=change-this-to-a-secure-key
PORT=8420
DATABASE_URL=postgresql://jdl:change-me-in-production@localhost:5432/jdl_core
POSTGRES_USER=jdl
POSTGRES_PASSWORD=<set-in-production>
POSTGRES_DB=jdl_core
CORS_ORIGIN=http://localhost:8420
ENCRYPTION_KEY=<generate with: node -e "console.log(require(\'crypto\').randomBytes(32).toString(\'hex\'))">
MAIN_WALLET=your-eth-wallet-address
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
PRIVATE_KEY=<paste-dev-key-here>
USE_RUST_CORE=false
RUST_CORE_PATH=./target/release/jdl-core

# === Missing vars detected via audit ===

SESSION_SECRET=<set-in-production>
NODE_ENV=development
PYTHON_WORKER_PATH=./python/bridge.py
ALCHEMY_ETH_KEY=demo-key-from-alchemy.com
AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc
OP_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://sepolia.drpc.org
DRY_RUN=true
SYSTEM_WALLET_PRIVATE_KEY=your-system-wallet-private-key
SYSTEM_WALLET_MNEMONIC=your-system-wallet-mnemonic-phrase
SYSTEM_WALLET_CREATED_AT=2026-01-01T00:00:00.000Z
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379

# ── Trade parameters / real-data policy ──────────────────────────────────────
# CHAIN_ID: 42161 = Arbitrum One (mainnet, REAL-DATA-ONLY). 11155111 = Sepolia
# testnet (the ONLY network where simulated/sample data is permitted).
CHAIN_ID=42161
# Real on-chain Uniswap V3 quotes (forced ON automatically on any mainnet).
USE_REAL_QUOTES=1
# RPC failover: extra comma-separated RPCs tried if the primary fails. The public
# Arbitrum node is always appended last, so the engine never goes fully offline.
# RPC_FALLBACKS=https://arbitrum.llamarpc.com,https://arb1.arbitrum.io/rpc
# Small-revenue gathering: lower MIN_PROFIT_USD to take tiny real edges.
MIN_PROFIT_USD=0.50
# Fixed loan size (USD) used when MAXIMISE_REVENUE is off.
REAL_LOAN_USD=10000
# Maximum-revenue mode: size each loan with LoanOptimizer up to the pool limit.
MAXIMISE_REVENUE=0
# Broadcast real transactions (needs FLASH_CONTRACT_ADDRESS + funded PRIVATE_KEY).
LIVE_EXECUTION=0

# ── Risk limits (risk_limits.py) ─────────────────────────────────────────────
# Bounds on the live execution path, checked before every broadcast. They matter
# most for the unattended swarm daemon: every reverting broadcast still costs
# gas, and a systemically broken route reverts on every cycle, forever, with
# nobody watching. The defaults below are what you get if you set none of them.
#
# Consecutive failed/reverted broadcasts that open the circuit breaker.
MAX_CONSECUTIVE_FAILURES=3
# Cooldown once the breaker opens, in seconds. Doubles with each further failure
# up to RISK_COOLDOWN_MAX_SEC; a single success closes the breaker outright.
RISK_COOLDOWN_SEC=60
RISK_COOLDOWN_MAX_SEC=3600
# Stop executing once the UTC day's realised P&L (profit earned minus all gas
# burned, failures included) is this far down. Resets at the UTC day rollover.
MAX_DAILY_LOSS_USD=25
# Operator kill switch. `touch` this file to halt execution immediately without
# signals or a restart, `rm` it to resume. Defaults to ~/.flash_loan_engine/HALT.
# HALT_FILE=
