PRIVATE_KEY=<set-via-secrets-manager>
WALLET_ADDRESS=<derived-from-key>
ALCHEMY_ETH_KEY=<set-via-secrets-manager>
ALCHEMY_ARB_KEY=<set-via-secrets-manager>
ALCHEMY_SOL_KEY=<set-via-secrets-manager>
FLASHBOTS_SECRET=<set-via-secrets-manager>
ETHERSCAN_KEY=<set-via-secrets-manager>
SESSION_SECRET=<set-via-secrets-manager>
DATABASE_URL=postgresql://...

POSTGRES_USER=jdl
POSTGRES_PASSWORD=<set-via-secrets-manager>
POSTGRES_DB=jdl_production

DRY_RUN=false
MIN_PROFIT_USD=2.0
MAX_LOAN_USD=500000

# Risk limits — see risk_limits.py and .env.example for what each one does.
# Tighter than the built-in defaults, on the assumption a production deployment
# would rather stop early and be looked at than keep bleeding gas unattended.
MAX_CONSECUTIVE_FAILURES=3
RISK_COOLDOWN_SEC=120
RISK_COOLDOWN_MAX_SEC=3600
MAX_DAILY_LOSS_USD=10
RATE_LIMIT=100/15m
LOG_LEVEL=info
