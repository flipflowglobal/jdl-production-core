[Unit]
Description=JDL Production Core — Trading Bot API Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=jdl
WorkingDirectory=/opt/jdl-core
EnvironmentFile=/opt/jdl-core/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
